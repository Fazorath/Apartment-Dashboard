# Production settings for docker-compose.yml. Copy to a path outside git, chmod 600,
# and point APP_ENV_FILE at it. Never commit the filled-in copy.
NODE_ENV=production
# One reverse proxy (Caddy) in front: rate limits then see each Roommate's own address
TRUST_PROXY=1
# The public origin; links in emails and CORS use it
FRONTEND_URL=https://chores.lab.arcanumhernandez.com
# Compose already points the app at its mongo service; this matches it
MONGODB_URI=mongodb://mongo:27017
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Verification and password-reset email. Production refuses to send without SMTP_HOST
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Roommate Dash <no-reply@example.com>"
