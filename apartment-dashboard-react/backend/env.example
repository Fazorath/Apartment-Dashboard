# Database Configuration
# Base MongoDB URI - apartment-specific databases will be created automatically
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-here

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Multi-Apartment Configuration
# Each apartment gets its own database: apartment_[code]
# Main database: apartment_dashboard_main (for user management)
# Example databases:
# - apartment_dashboard_main (users, apartment info)
# - apartment_abc123 (tasks for apartment ABC123)
# - apartment_xyz789 (tasks for apartment XYZ789)

# Email (verification links, password resets)
# Leave these commented out in development: emails are printed to the backend console instead.
# In production, set SMTP_HOST (and the rest) to send real email.
# Links in emails point at FRONTEND_URL.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# true for port 465 (implicit TLS); false uses STARTTLS on 587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# MAIL_FROM="Roommate Dash <no-reply@example.com>"

# Sign in with Google (OAuth client from Google Cloud Console > APIs & Services > Credentials,
# type "Web application"). While unset, "Continue with Google" says it isn't set up.
# Add the redirect URI below to the client's "Authorized redirect URIs". It is a frontend
# page (default: FRONTEND_URL + /auth/google/callback) that hands the code to this API.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Sign in with Apple (needs a paid Apple Developer account). While any of these is unset,
# "Continue with Apple" says it isn't set up.
# In developer.apple.com > Certificates, Identifiers & Profiles:
#   1. Identifiers > App IDs: an App ID with "Sign in with Apple" enabled
#   2. Identifiers > Services IDs: a Services ID, with "Sign in with Apple" configured:
#      - Domains: the API's domain (no scheme, no port), e.g. api.example.com
#      - Return URLs: APPLE_REDIRECT_URI below, verbatim
#   3. Keys: a key with "Sign in with Apple" enabled; download the .p8 file (once only)
# Apple needs a public https domain, so this can't be tried on localhost without a tunnel.
# The Services ID identifier (not the App ID)
# APPLE_CLIENT_ID=com.example.roommate.web
# Membership > Team ID
# APPLE_TEAM_ID=ABCDE12345
# The key's ID (the 10 characters in the .p8 file name)
# APPLE_KEY_ID=ABC123DEFG
# The .p8 file's contents. On one line, write the line breaks as \n
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
# The API endpoint Apple posts the browser back to; it passes the code on to the frontend page
# (FRONTEND_URL + /auth/apple/callback), so FRONTEND_URL must be set to the real site in production
# APPLE_REDIRECT_URI=https://api.example.com/api/auth/apple/return
