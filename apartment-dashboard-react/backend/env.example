# Database Configuration
# Base MongoDB URI - apartment-specific databases will be created automatically
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-here

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Multi-Apartment Configuration
# Each apartment gets its own database: apartment_[code]
# Main database: apartment_dashboard_main (for user management)
# Example databases:
# - apartment_dashboard_main (users, apartment info)
# - apartment_abc123 (tasks for apartment ABC123)
# - apartment_xyz789 (tasks for apartment XYZ789)
